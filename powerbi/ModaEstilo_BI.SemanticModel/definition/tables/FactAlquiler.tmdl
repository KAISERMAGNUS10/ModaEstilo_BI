table FactAlquiler
	lineageTag: 2b4d82e4-be62-57df-a96b-657f8ac60026

	measure 'Ingreso Alquileres' = SUM(FactAlquiler[ImporteAlquiler])
		formatString: #,##0.00
		displayFolder: Alquileres
		lineageTag: c98ab8b1-ce75-5ce4-9c00-6250e124e539

	measure 'Número de Alquileres' = DISTINCTCOUNT(FactAlquiler[AlquilerID])
		formatString: #,##0
		displayFolder: Alquileres
		lineageTag: 599bcbc2-f286-55fb-b9db-db7d87137279

	measure 'Alquileres Pendientes' = CALCULATE([Número de Alquileres], FactAlquiler[EstadoAlquiler] IN {"En curso", "Reservado", "Vencido"})
		formatString: #,##0
		displayFolder: Alquileres
		lineageTag: 0ce6d8a5-5599-5414-ba52-46530add107c

	measure 'Alquileres Devueltos' = CALCULATE([Número de Alquileres], FactAlquiler[EstadoAlquiler] = "Devuelto")
		formatString: #,##0
		displayFolder: Alquileres
		lineageTag: b77ecdd5-b8db-50af-8d0d-e34ea5eac560

	measure 'Tasa de Devolución' = DIVIDE([Alquileres Devueltos], [Número de Alquileres])
		formatString: 0.00%
		displayFolder: Alquileres
		lineageTag: 6b824bf2-42ee-5666-9b35-9e311c0ef0ed

	measure 'Devoluciones con Retraso' = CALCULATE([Número de Alquileres], FactAlquiler[FuePuntual] == 0)
		formatString: #,##0
		displayFolder: Alquileres
		lineageTag: d4ae67e1-1ead-54f5-80d0-ad8897923bfd

	measure '% Devoluciones con Retraso' = DIVIDE([Devoluciones con Retraso], [Alquileres Devueltos])
		formatString: 0.00%
		displayFolder: Alquileres
		lineageTag: 5523bfc8-0e42-56c5-818c-d56efe3be6ed

