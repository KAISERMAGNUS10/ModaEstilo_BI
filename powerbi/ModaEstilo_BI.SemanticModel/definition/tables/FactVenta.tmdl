table FactVenta
	lineageTag: 520167ca-fbc7-595b-866a-ed2f2feea0f7

	measure 'Ingreso Ventas' = SUM(FactVenta[ImporteVenta])
		formatString: #,##0.00
		displayFolder: Ventas
		lineageTag: ad78b470-cca3-51ea-b5da-c72876e9d6cd

	measure 'Número de Ventas' = DISTINCTCOUNT(FactVenta[VentaID])
		formatString: #,##0
		displayFolder: Ventas
		lineageTag: cc07ab04-55cb-5e20-9138-bc57f0980438

	measure 'Unidades Vendidas' = SUM(FactVenta[Cantidad])
		formatString: #,##0
		displayFolder: Ventas
		lineageTag: 48ef2ed0-e5e4-5ef8-b951-74acafe6b2bf

	measure 'Ticket Promedio Venta' = DIVIDE([Ingreso Ventas], [Número de Ventas])
		formatString: #,##0.00
		displayFolder: Ventas
		lineageTag: 4dff219d-9f47-55e5-a33f-abf1c64fa3e0

	measure 'Margen Bruto Ventas' = SUM(FactVenta[MargenBrutoVenta])
		formatString: #,##0.00
		displayFolder: Ventas
		lineageTag: 4118c43e-01a8-5a6d-8155-5dabb5a00e23

	measure '% Margen Bruto' = DIVIDE([Margen Bruto Ventas], [Ingreso Ventas])
		formatString: 0.00%
		displayFolder: Ventas
		lineageTag: 26154c24-c7f7-544d-8e41-aae46c1c79b5

	measure 'Unidades Vendidas Top 10' = IF(ISINSCOPE(DimArticulo[Articulo]), IF(SELECTEDVALUE(DimArticulo[Articulo]) IN TOPN(10, ALLSELECTED(DimArticulo[Articulo]), [Unidades Vendidas], DESC, DimArticulo[Articulo], ASC), [Unidades Vendidas]), [Unidades Vendidas])
		formatString: #,##0
		displayFolder: Ventas
		lineageTag: ac3ca544-8ee6-500e-9f9b-a0ede6e2397e

	measure 'Ingreso Total' = [Ingreso Ventas] + [Ingreso Alquileres]
		formatString: #,##0.00
		displayFolder: Resumen
		lineageTag: b794e0cb-5eff-575a-8092-c00789a85f02

	measure 'Número de Operaciones' = [Número de Ventas] + [Número de Alquileres]
		formatString: #,##0
		displayFolder: Resumen
		lineageTag: 3626e5dd-ff75-59f3-b769-bc034950b415

	measure 'Ticket Promedio' = DIVIDE([Ingreso Total], [Número de Operaciones])
		formatString: #,##0.00
		displayFolder: Resumen
		lineageTag: 54d4c7de-7180-5cb5-a6d1-2f8d9f61f174

